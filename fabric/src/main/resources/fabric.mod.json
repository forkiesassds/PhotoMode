{
  "schemaVersion": 1,
  "id": "picturemode",
  "version": "${version}",

  "name": "Picture Mode",
  "description": "This mod adds an isometric view of the world dedicated for taking pictures.\nInspired by the Photo Mode from Better than Adventure!",
  "authors": ["icanttellyou"],
  "contributors": [],
  "contact": {
    "homepage": "https://modrinth.com/project/picture-mode",
    "sources": "https://codeberg.org/icanttellyou/PictureMode",
    "issues": "https://codeberg.org/icanttellyou/PictureMode/issues"
  },

  "license": "LGPLv3",
  "icon": "assets/picturemode/icon.png",

  "environment": "*",
  "entrypoints": {
    "client": [
      "mod.icanttellyou.picturemode.fabric.client.PictureModeFabricClient"
    ]
  },
  "mixins": [
    "picturemode-common.mixins.json",
    "picturemode-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}"
  }
}
